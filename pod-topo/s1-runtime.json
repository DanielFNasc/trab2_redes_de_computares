{
  "target": "bmv2",
  "p4info": "build/basic.p4.p4info.txtpb",
  "bmv2_json": "build/basic.json",
  "table_entries": [
    {
      "table": "MyIngress.ipv4_lpm",
      "default_action": true,
      "action_name": "MyIngress.drop",
      "action_params": {}
    },
    {
      "table": "MyIngress.ipv4_lpm",
      "match": { "hdr.ipv4.dstAddr": ["10.0.0.1", 32] },
      "action_name": "MyIngress.ipv4_forward",
      "action_params": { "dstAddr": "08:00:00:00:01:11", "port": 1 }
    },
    {
      "table": "MyIngress.ipv4_lpm",
      "match": { "hdr.ipv4.dstAddr": ["10.0.0.2", 32] },
      "action_name": "MyIngress.ipv4_forward",
      "action_params": { "dstAddr": "08:00:00:00:02:22", "port": 2 }
    },
    {
      "table": "MyIngress.ipv4_lpm",
      "match": { "hdr.ipv4.dstAddr": ["200.0.0.2", 32] },
      "action_name": "MyIngress.ipv4_forward",
      "action_params": { "dstAddr": "08:00:00:00:03:33", "port": 3 }
    },

    {
      "table": "MyIngress.nat_in_static",
      "match": { "meta.dstPort": 8080, "hdr.ipv4.protocol": 6 },
      "action_name": "MyIngress.static_in",
      "action_params": { "private_ip": "10.0.0.1", "private_port": 80 }
    },
    {
      "table": "MyIngress.nat_out_static",
      "match": { "hdr.ipv4.srcAddr": "10.0.0.1", "meta.srcPort": 80, "hdr.ipv4.protocol": 6 },
      "action_name": "MyIngress.static_out",
      "action_params": { "public_port": 8080 }
    },
    {
      "table": "MyIngress.nat_in_static",
      "match": { "meta.dstPort": 2222, "hdr.ipv4.protocol": 6 },
      "action_name": "MyIngress.static_in",
      "action_params": { "private_ip": "10.0.0.2", "private_port": 22 }
    },
    {
      "table": "MyIngress.nat_out_static",
      "match": { "hdr.ipv4.srcAddr": "10.0.0.2", "meta.srcPort": 22, "hdr.ipv4.protocol": 6 },
      "action_name": "MyIngress.static_out",
      "action_params": { "public_port": 2222 }
    }
  ]
}
